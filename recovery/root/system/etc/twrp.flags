# Boot & Recovery
/boot           emmc    /dev/block/by-name/boot            flags=display="Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/by-name/recovery        flags=display="Recovery";backup=1;flashimg=1

# Dynamic Partitions (Logical)
/system_root    ext4    /dev/block/mapper/system           flags=display="System";backup=1;flashimg=1;logical
/vendor         ext4    /dev/block/mapper/vendor           flags=display="Vendor";backup=1;flashimg=1;logical
/product        ext4    /dev/block/mapper/product          flags=display="Product";backup=1;flashimg=1;logical

# Main Storage & Cache
/metadata       ext4    /dev/block/platform/bootdevice/by-name/md_udc          flags=display="Metadata";backup=1
/data           f2fs    /dev/block/platform/bootdevice/by-name/userdata        flags=display="Data";backup=1;wipeingui;fileencryption=aes-256-xts;mounttodecrypt
/cache          ext4    /dev/block/by-name/cache           flags=display="Cache";backup=1;wipeingui
/super          emmc    /dev/block/by-name/super           flags=display="Super Partition";backup=1;flashimg=1

# MTK Security & NVRAM Blocks
/persist        ext4    /dev/block/by-name/persist         flags=display="Persist";backup=1
/nvdata         ext4    /dev/block/by-name/nvdata          flags=display="NVData";backup=1
/nvcfg          ext4    /dev/block/by-name/nvcfg           flags=display="NVConfig";backup=1
/protect_f      ext4    /dev/block/by-name/protect1        flags=display="Protect1";backup=1
/protect_s      ext4    /dev/block/by-name/protect2        flags=display="Protect2";backup=1
/nvram          emmc    /dev/block/by-name/nvram           flags=display="NVRAM";backup=1

# Misc, Firmware & Partition Images
/misc           emmc    /dev/block/by-name/para            flags=display="Misc";backup=1
/frp            emmc    /dev/block/by-name/frp             flags=display="FRP";backup=1
/logo           emmc    /dev/block/by-name/logo            flags=display="Logo";backup=1;flashimg=1
/dtbo           emmc    /dev/block/by-name/dtbo            flags=display="DTBO";backup=1;flashimg=1
/vbmeta         emmc    /dev/block/by-name/vbmeta          flags=display="VBMeta";backup=1;flashimg=1
/bootloader     emmc    /dev/block/by-name/lk              flags=display="LK";backup=1;flashimg=1
/bootloader2    emmc    /dev/block/by-name/lk2             flags=display="LK2";backup=1;flashimg=1
/preloader_a    emmc    /dev/block/by-name/preloader_a     flags=display="Preloader A"
/preloader_b    emmc    /dev/block/by-name/preloader_b     flags=display="Preloader B"
/tee1           emmc    /dev/block/by-name/tee1            flags=display="TEE1";backup=1
/tee2           emmc    /dev/block/by-name/tee2            flags=display="TEE2";backup=1
/scp1           emmc    /dev/block/by-name/scp1            flags=display="SCP1";backup=1
/scp2           emmc    /dev/block/by-name/scp2            flags=display="SCP2";backup=1
/sspm_1         emmc    /dev/block/by-name/sspm_1          flags=display="SSPM1";backup=1
/sspm_2         emmc    /dev/block/by-name/sspm_2          flags=display="SSPM2";backup=1
/md1img         emmc    /dev/block/by-name/md1img          flags=display="Modem";backup=1
/spmfw          emmc    /dev/block/by-name/spmfw           flags=display="SPMFW"
/gz1            emmc    /dev/block/by-name/gz1             flags=display="GZ1"
/gz2            emmc    /dev/block/by-name/gz2             flags=display="GZ2"
/sec1           emmc    /dev/block/by-name/sec1            flags=display="Sec1"
/boot_para      emmc    /dev/block/by-name/boot_para       flags=display="Boot Para"
/tkv            emmc    /dev/block/by-name/tkv             flags=display="TKV"
/expdb          emmc    /dev/block/by-name/expdb           flags=display="EXPDB"
/seccfg         emmc    /dev/block/by-name/seccfg          flags=display="SecCfg"
/flashinfo      emmc    /dev/block/by-name/flashinfo       flags=display="Flash Info"
/otp            emmc    /dev/block/by-name/otp             flags=display="OTP"
/tranfs         ext4    /dev/block/by-name/tranfs          flags=display="TranFS";backup=1

# External Storage
/external_sd    auto    /dev/block/mmcblk1p1  /dev/block/mmcblk1  flags=display="Micro SD Card";storage;wipeingui;removable
/usb_otg        auto    /dev/block/sda1       /dev/block/sda      flags=display="USB OTG";storage;wipeingui;removable
