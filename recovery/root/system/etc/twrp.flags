# Infinix X655C (MT6765) - Optimized Recovery Flags Configuration
# Tailored for Native FBE Decryption, Dynamic Partitions, and GSI Flashing

# LOGICAL PARTITIONS (Configured for Dynamic Resizing & GSI System Switches)
/system          ext4    system                                         flags=display="System";backup=1;logical;wipeingui
/vendor          ext4    vendor                                         flags=display="Vendor";backup=1;logical;wipeingui
/product         ext4    product                                        flags=display="Product";backup=1;logical;wipeingui

# IMAGE FLASHING TARGETS (Enables direct flashing of raw .img files to dynamic slots)
/system_image    emmc    /dev/block/mapper/system                       flags=display="System Image";flashimg=1;backup=1
/vendor_image    emmc    /dev/block/mapper/vendor                       flags=display="Vendor Image";flashimg=1;backup=1
/product_image   emmc    /dev/block/mapper/product                      flags=display="Product Image";flashimg=1;backup=1
/super           emmc    /dev/block/platform/bootdevice/by-name/super   flags=display="Super Partition";backup=1;flashimg=1

# Core System Block Storage Mappings
/metadata        ext4    /dev/block/platform/bootdevice/by-name/md_udc  flags=display="Metadata";backup=1
/cache           ext4    /dev/block/platform/bootdevice/by-name/cache   flags=display="Cache";backup=1;wipeingui
/data            f2fs    /dev/block/platform/bootdevice/by-name/userdata flags=display="Data";backup=1;wipeingui

# Boot, Kernel, and AVB Security Links
/boot            emmc    /dev/block/platform/bootdevice/by-name/boot    flags=display="Boot";backup=1;flashimg=1
/recovery        emmc    /dev/block/platform/bootdevice/by-name/recovery flags=display="Recovery";backup=1;flashimg=1
/dtbo            emmc    /dev/block/platform/bootdevice/by-name/dtbo    flags=display="DTBO";backup=1;flashimg=1
/vbmeta          emmc    /dev/block/platform/bootdevice/by-name/vbmeta  flags=display="VBMeta";backup=1;flashimg=1
/vbmeta_system   emmc    /dev/block/platform/bootdevice/by-name/vbmeta_system flags=display="VBMeta System";backup=1;flashimg=1
/vbmeta_vendor   emmc    /dev/block/platform/bootdevice/by-name/vbmeta_vendor flags=display="VBMeta Vendor";backup=1;flashimg=1

# MediaTek Security and Non-Volatile Memory Partitions
/nvram           emmc    /dev/block/platform/bootdevice/by-name/nvram   flags=display="NVRAM";backup=1;flashimg=1
/nvdata          ext4    /dev/block/platform/bootdevice/by-name/nvdata   flags=display="NVData";backup=1;subpartitionof=/nvram
/nvcfg           ext4    /dev/block/platform/bootdevice/by-name/nvcfg    flags=display="NVConfig";backup=1;subpartitionof=/nvram
/persist         ext4    /dev/block/platform/bootdevice/by-name/persist  flags=display="Persist";backup=1
/protect_f       ext4    /dev/block/platform/bootdevice/by-name/protect1 flags=display="Protect1";backup=1;subpartitionof=/nvram
/protect_s       ext4    /dev/block/platform/bootdevice/by-name/protect2 flags=display="Protect2";backup=1;subpartitionof=/nvram

# Hardware Security & Microtrust Environment Hooks
/tee1            emmc    /dev/block/platform/bootdevice/by-name/tee1    flags=display="TEE1";backup=1
/tee2            emmc    /dev/block/platform/bootdevice/by-name/tee2    flags=display="TEE2";backup=1;subpartitionof=/tee1
/scp1            emmc    /dev/block/platform/bootdevice/by-name/scp1    flags=display="SCP1";backup=0
/scp2            emmc    /dev/block/platform/bootdevice/by-name/scp2    flags=display="SCP2";backup=0
/md1img          emmc    /dev/block/platform/bootdevice/by-name/md1img  flags=display="Modem Baseband";backup=1

# Auxiliary Control Partition Targets
/misc            emmc    /dev/block/platform/bootdevice/by-name/para    flags=display="Misc";backup=0
/logo            emmc    /dev/block/platform/bootdevice/by-name/logo    flags=display="Boot Logo";backup=1;flashimg=1
/bootloader      emmc    /dev/block/platform/bootdevice/by-name/lk      flags=display="LK (Bootloader)";backup=1;flashimg=1
/bootloader2     emmc    /dev/block/platform/bootdevice/by-name/lk2     flags=display="LK2";backup=1;subpartitionof=/bootloader
/tranfs          ext4    /dev/block/platform/bootdevice/by-name/tranfs  flags=display="TranFS";backup=1

# Removable External Storage Interfaces
/external_sd     auto    /dev/block/mmcblk1p1    /dev/block/mmcblk1     flags=display="MicroSD Card";storage;wipeingui;removable
/usb_otg         auto    /dev/block/sda1         /dev/block/sda         flags=display="USB OTG";storage;wipeingui;removable
